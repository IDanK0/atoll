    <!-- Informazioni -->
    <string name="about_meta_version">Versione %1$s (%2$d)</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Atoll usa gli aggiornamenti in tempo reale di Android per mostrare la pillola. Il permesso facoltativo di apparire sopra le altre app serve solo per il righello di calibrazione. Atoll non usa i servizi di accessibilità, non legge le notifiche di altre app e non accede a Internet. Android può includere le impostazioni nel backup del dispositivo.</string>
    <string name="about_credits_title">Marchi</string>
    <string name="about_credits_body">iPhone e Dynamic Island sono marchi di Apple Inc. e servono solo a indicare le misure di riferimento. ColorOS appartiene a OPPO. Atoll non è collegata a nessuna delle due aziende.</string>
    <string name="about_show_licenses">Mostra le licenze open source</string>
    <string name="about_hide_licenses">Nascondi le licenze open source</string>

