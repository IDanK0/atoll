<?xml version="1.0" encoding="utf-8"?>
<!-- radice FrameLayout: con un LinearLayout ColorOS taglia la scheda in basso -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent,ContentDescription,UseCompoundDrawables"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tl_die"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tl_value"
                    style="@style/CardValue"
                    android:textSize="36sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tl_caption"
                    style="@style/CardCaption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tl_btn_0"
                style="@style/CardPill" />

            <TextView
                android:id="@+id/tl_btn_1"
                style="@style/CardPill"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tl_btn_2"
                style="@style/CardPill"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
